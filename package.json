{
	"name": "my-snow-monkey-boilerplate",
	"private": true,
	"type": "module",
	"scripts": {
		"wp-env": "wp-env",
		"postcss": "postcss src/styles/style.css --dir dist",
		"build": "run-p build:*",
		"build:styles": "npm run postcss",
		"watch": "run-p watch:*",
		"watch:styles": "npm run postcss -- -w",
		"watch:server": "browser-sync start --proxy \"localhost:8888\" --files .",
		"lint": "run-p lint:*",
		"lint:stylelint": "stylelint '**/*.css'",
		"lint:prettier": "prettier . --check --ignore-unknown",
		"fix": "run-s fix:{stylelint,prettier}",
		"fix:stylelint": "npm run lint:stylelint -- --fix",
		"fix:prettier": "npm run lint:prettier -- --write"
	},
	"devDependencies": {
		"@wordpress/browserslist-config": "6.55.0",
		"@wordpress/env": "11.15.0",
		"@wordpress/prettier-config": "4.55.0",
		"@wordpress/stylelint-config": "25.0.0",
		"autoprefixer": "10.6.1",
		"browser-sync": "3.0.4",
		"cssnano": "9.0.5",
		"lefthook": "2.1.14",
		"npm-run-all2": "9.0.3",
		"postcss": "8.5.28",
		"postcss-cli": "12.0.0",
		"postcss-import": "17.0.0",
		"postcss-nested": "8.0.1",
		"postcss-preset-env": "11.5.3",
		"stylelint": "17.15.0",
		"stylelint-config-recess-order": "7.8.0"
	},
	"volta": {
		"node": "24.21.0"
	}
}
